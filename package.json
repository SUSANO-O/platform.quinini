{
  "name": "agent-flow-landing",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "build:widget": "node scripts/widget/build.mjs && node scripts/widget/verify-build.mjs",
    "dev": "next dev -p 3201",
    "dev:clean": "npm run clean && npm run dev",
    "stack:up": "bash ../scripts/botiva-local-up.sh",
    "stack:down": "bash ../scripts/botiva-local-down.sh",
    "stack:status": "bash ../scripts/botiva-local-status.sh",
    "build": "npm run build:widget && next build",
    "start": "next start -p 3201",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-test.mjs",
    "test:bdd": "node node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:bdd:smoke": "node node_modules/@cucumber/cucumber/bin/cucumber.js --tags \"@smoke\"",
    "test:widget": "node scripts/widget-chat-test.mjs",
    "test:widget:smoke": "node --env-file=.env scripts/widget-chat-smoke.mjs",
    "test:widget:stress": "node --env-file=.env scripts/widget-stress-inventory.mjs",
    "test:widget:harness": "node --env-file=.env scripts/widget-harness-inventory.mjs",
    "test:aibackhub:model": "node --env-file=.env scripts/test-aibackhub-model.mjs",
    "test:widget:webhook": "node scripts/widget-webhook-force-test.mjs",
    "verify:mcp-phases": "node scripts/verify-mcp-phases.mjs",
    "gen:rag-examples": "node scripts/write-rag-example-assets.mjs",
    "sync:lemonsqueezy": "node scripts/sync-lemonsqueezy-prices.mjs",
    "sync:lemonsqueezy:apply": "node scripts/sync-lemonsqueezy-prices.mjs --apply",
    "setup:lemonsqueezy": "node scripts/setup-lemonsqueezy-plans.mjs",
    "setup:lemonsqueezy:audit": "node scripts/setup-lemonsqueezy-plans.mjs --audit",
    "setup:lemonsqueezy:sync": "node scripts/setup-lemonsqueezy-plans.mjs --sync-env",
    "pricing:audit": "node scripts/pricing-audit.mjs",
    "verify:pricing": "node scripts/verify-pricing-sync.mjs",
    "sync:legacy-agents": "node --env-file=.env scripts/sync-legacy-agents-to-hub.mjs",
    "migrate:vertex-models": "node --env-file=.env scripts/migrate-obsolete-vertex-models.mjs",
    "sync:vertex-catalog": "node scripts/sync-vertex-catalog.mjs",
    "enable:model-catalog": "node --env-file=.env scripts/enable-model-catalog.mjs",
    "sync:huggingface-catalog": "node --env-file=.env scripts/sync-huggingface-catalog.mjs",
    "inspect:widget": "node --env-file=.env scripts/inspect-widget.mjs",
    "ensure:prod-lab": "npx tsx --env-file=.env scripts/ensure-prod-sales-and-lab.mts",
    "ensure:prod-sales": "npx tsx --env-file=.env scripts/ensure-prod-sales-agent.mts",
    "ensure:prod-taller-repuestos": "npx tsx --env-file=.env scripts/ensure-prod-taller-repuestos.mts",
    "stress:landing": "node --env-file=.env scripts/stress-landing.mjs",
    "stress:landing:widget": "node --env-file=.env scripts/stress-landing.mjs --mode widget",
    "stress:landing:multiagent": "node --env-file=.env scripts/stress-landing.mjs --mode multiagent --concurrency 5 --duration 20",
    "stress:landing:all": "node --env-file=.env scripts/stress-landing.mjs --mode all",
    "test:webhook-gating": "node --env-file=.env scripts/webhook-gating-smoke.mjs",
    "test:flows": "node --env-file=.env scripts/test-flows-smoke.mjs",
    "test:flows:integration": "node --env-file=.env scripts/test-flows-integration.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
