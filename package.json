{
  "name": "agent-flow-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "next dev -p 3201",
    "dev:clean": "npm run clean && npm run dev",
    "build": "next build",
    "start": "next start -p 3201",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-test.mjs",
    "test:widget": "node scripts/widget-chat-test.mjs",
    "test:widget:webhook": "node scripts/widget-webhook-force-test.mjs",
    "verify:mcp-phases": "node scripts/verify-mcp-phases.mjs",
    "gen:rag-examples": "node scripts/write-rag-example-assets.mjs",
    "sync:lemonsqueezy": "node scripts/sync-lemonsqueezy-prices.mjs",
    "sync:lemonsqueezy:apply": "node scripts/sync-lemonsqueezy-prices.mjs --apply",
    "setup:lemonsqueezy": "node scripts/setup-lemonsqueezy-plans.mjs",
    "setup:lemonsqueezy:audit": "node scripts/setup-lemonsqueezy-plans.mjs --audit",
    "setup:lemonsqueezy:sync": "node scripts/setup-lemonsqueezy-plans.mjs --sync-env",
    "pricing:audit": "node scripts/pricing-audit.mjs",
    "verify:pricing": "node scripts/verify-pricing-sync.mjs",
    "sync:legacy-agents": "node --env-file=.env scripts/sync-legacy-agents-to-hub.mjs",
    "stress:landing": "node --env-file=.env scripts/stress-landing.mjs",
    "stress:landing:widget": "node --env-file=.env scripts/stress-landing.mjs --mode widget",
    "stress:landing:multiagent": "node --env-file=.env scripts/stress-landing.mjs --mode multiagent --concurrency 5 --duration 20",
    "stress:landing:all": "node --env-file=.env scripts/stress-landing.mjs --mode all",
    "test:webhook-gating": "node --env-file=.env scripts/webhook-gating-smoke.mjs"
  },
  "dependencies": {
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@mozilla/readability": "^0.6.0",
    "@paddle/paddle-node-sdk": "^1.10.0",
    "@react-three/drei": "^10.0.3",
    "@react-three/fiber": "^9.0.4",
    "@sparticuz/chromium": "^148.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/web-push": "^3.6.4",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "driver.js": "^1.4.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.0",
    "mongodb": "^6.12.0",
    "mongoose": "^9.4.1",
    "next": "^15.3.2",
    "next-intl": "^4.9.1",
    "next-pwa": "^5.6.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.13.1",
    "puppeteer-core": "^25.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-joyride": "^3.0.2",
    "resend": "^6.10.0",
    "sonner": "^2.0.7",
    "three": "^0.172.0",
    "turndown": "^7.2.4",
    "web-push": "^3.6.7"
  },
  "_stripe_commented": {
    "_note": "Stripe desactivado — migrado a Paddle. Para reactivar: npm install stripe @stripe/stripe-js @stripe/react-stripe-js",
    "_stripe": "^22.0.0",
    "_stripe_stripe-js": "^9.1.0",
    "_stripe_react-stripe-js": "^6.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^3.2.4",
    "archiver": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
