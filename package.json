    "next": "^15.3.2",
    "next-intl": "^4.9.1",
    "next-pwa": "^5.6.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.13.1",
    "puppeteer-core": "^25.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-joyride": "^3.0.2",
    "resend": "^6.10.0",
    "sonner": "^2.0.7",
    "speakeasy": "^2.0.0",
    "three": "^0.172.0",
    "turndown": "^7.2.4",
    "web-push": "^3.6.7",
    "zustand": "^5.0.14"
  },
  "_stripe_commented": {
    "_note": "Stripe desactivado — migrado a Paddle. Para reactivar: npm install stripe @stripe/stripe-js @stripe/react-stripe-js",
    "_stripe": "^22.0.0",
    "_stripe_stripe-js": "^9.1.0",
    "_stripe_react-stripe-js": "^6.1.0"
  },
  "devDependencies": {
