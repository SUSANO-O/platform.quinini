{
  "crons": [
    {
      "path": "/api/internal/subscription-reminders",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/internal/inbox-follow-ups",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/internal/warmup",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/internal/sheet-sync",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
